<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="470.0" prefWidth="350.0" spacing="10" style="-fx-background-color: #1E3A66;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DetailsCategorie">

    <Label styleClass="title2" text="Détails de la Catégorie" translateY="-5.0" />

    <Label fx:id="labelReference" contentDisplay="RIGHT" maxHeight="22.0" maxWidth="250.0" prefHeight="22.0" prefWidth="110.0" styleClass="case" text="Référence : -" translateY="-25.0">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <Label fx:id="labelNomCategorie" contentDisplay="RIGHT" maxHeight="22.0" maxWidth="250.0" prefHeight="22.0" prefWidth="109.0" styleClass="case" text="Nom : -" translateY="-25.0">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <Label fx:id="labelDescriptionCategorie" contentDisplay="RIGHT" maxHeight="22.0" maxWidth="250.0" prefHeight="22.0" prefWidth="112.0" styleClass="case" text="Description : -" translateY="-25.0" wrapText="true">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <Label fx:id="labelDateCreation" contentDisplay="RIGHT" maxHeight="22.0" maxWidth="250.0" prefHeight="22.0" prefWidth="115.0" styleClass="case" text="Date de création : -" translateY="-25.0">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <Button maxHeight="52.0" maxWidth="100.0" onAction="#fermerFenetre" prefHeight="52.0" prefWidth="79.0" stylesheets="@style.css" text="Fermer" translateX="-50.0" />
    <Button id="updtcat" fx:id="updtcat" maxHeight="52.0" maxWidth="100.0" onAction="#updtcat" prefHeight="52.0" prefWidth="100.0" stylesheets="@style.css" text="Mise à jour" translateX="70.0" translateY="-59.0" />

</VBox>
